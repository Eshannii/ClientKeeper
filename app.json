{
  "expo": {
    "name": "clientkeeper",
    "slug": "clientkeeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/screen.jpg",
    "scheme": "clientkeeper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/screen.jpg",
        "backgroundImage": "./assets/images/screen.jpg",
        "monochromeImage": "./assets/images/screen.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nayyab_noor.clientkeeper",
      "permissions": ["SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/screen.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/screen.jpg",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
